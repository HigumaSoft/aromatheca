# Copy to .env and set a real POSTGRES_PASSWORD. Data services only (see docker-compose.yml).

# PostgreSQL
POSTGRES_DB=aromatheca
POSTGRES_USER=aromatheca_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# MinIO (local S3-compatible object store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
